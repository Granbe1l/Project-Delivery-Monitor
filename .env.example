# Local development only. Use a managed PostgreSQL URL with sslmode=require in cloud.
DATABASE_URL=postgresql+psycopg://pdm:pdm_local_only@localhost:5432/pdm
POSTGRES_PASSWORD=pdm_local_only
# Optional server-side token. Never use a VITE_ variable for this value.
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYNC_MAX_PAGES=2
SYNC_REQUEST_BUDGET=35
SYNC_STALE_HOURS=24
PR_AGE_DAYS=14
PR_IDLE_DAYS=14
CI_FAILURE_THRESHOLD=3
LOG_LEVEL=INFO
